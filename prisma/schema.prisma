generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  RECRUITER
  MEMBER
  PARENT
  ACCOUNTANT
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DISABLED
}

enum DocumentType {
  PLAYER_VOLUNTEER_ADULT
  ROSTER_CONTRACT
  RECRUITER_CONTRACT
  PLAYER_MINOR
  PARENTAL_AUTHORIZATION
  SUSPENSION_NOTICE
  DONATION_RECEIPT
  ACCOUNTING_LEDGER
}

enum DocumentStatus {
  DRAFT
  IN_REVIEW
  PENDING_SIGNATURES
  PARTIALLY_SIGNED
  SIGNED
  REFUSED
  EXPIRED
  CANCELLED
  ARCHIVED
}

enum SignerRole {
  PLAYER
  RECRUITER
  ROSTER_MANAGER
  LEGAL_GUARDIAN
  TEAM_REPRESENTATIVE
  DONOR
  OTHER
}

enum SignerStatus {
  PENDING
  VERIFIED
  SIGNED
  REFUSED
  EXPIRED
  CANCELLED
}

enum SignatureAction {
  CODE_VERIFIED
  CONSENT_GIVEN
  SIGNED
  REFUSED
  INVITATION_SENT
  INVITATION_REVOKED
}

enum RosterStatus {
  RECRUITING
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum DisciplineType {
  WARNING
  TEMPORARY_SUSPENSION
  OTHER
}

enum FinanceEntryType {
  DONATION
  EXPENSE
  OTHER_INCOME
  ADJUSTMENT
}

enum FinanceEntryStatus {
  DRAFT
  VALIDATED
  CANCELLED
}

enum DonationStatus {
  RECORDED
  RECEIPT_ISSUED
  CANCELLED
}

model User {
  id                 String     @id @default(cuid()) @db.VarChar(30)
  email              String     @unique @db.VarChar(254)
  name               String     @db.VarChar(160)
  passwordHash       String?    @db.VarChar(255)
  role               UserRole   @default(MEMBER)
  status             UserStatus @default(PENDING)
  emailVerifiedAt    DateTime?  @db.DateTime(3)
  birthDate          DateTime?  @db.Date
  phone              String?    @db.VarChar(30)
  guardianName       String?    @db.VarChar(160)
  guardianEmail      String?    @db.VarChar(254)
  guardianPhone      String?    @db.VarChar(30)
  lastLoginAt        DateTime?  @db.DateTime(3)
  createdAt          DateTime   @default(now()) @db.DateTime(3)
  updatedAt          DateTime   @updatedAt @db.DateTime(3)

  sessions           AuthSession[]
  createdDocuments   Document[] @relation("DocumentCreator")
  createdTemplates   DocumentTemplate[] @relation("TemplateCreator")
  signings           DocumentSigner[] @relation("SignerUser")
  rosterMemberships  RosterMember[]
  createdRosters     Roster[]   @relation("RosterCreator")
  disciplineReceived DisciplinaryAction[] @relation("DisciplineTarget")
  disciplineCreated  DisciplinaryAction[] @relation("DisciplineCreator")
  auditLogs          AuditLog[] @relation("AuditActor")
  donationsRecorded  Donation[] @relation("DonationRecorder")
  receiptsCreated    Receipt[] @relation("ReceiptCreator")
  ledgerEntries      LedgerEntry[] @relation("LedgerCreator")
  parentLinks        ParentPlayerLink[] @relation("ParentLinks")
  playerLinks        ParentPlayerLink[] @relation("PlayerLinks")
  documentAccess     DocumentRecipient[]

  @@index([role, status])
  @@index([birthDate])
  @@map("users")
}

model AuthSession {
  id        String   @id @default(cuid()) @db.VarChar(30)
  tokenHash String   @unique @db.VarChar(255)
  userId    String   @db.VarChar(30)
  expiresAt DateTime @db.DateTime(3)
  createdAt DateTime @default(now()) @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("auth_sessions")
}

model DocumentTemplate {
  id            String       @id @default(cuid()) @db.VarChar(30)
  type          DocumentType
  name          String       @db.VarChar(180)
  description   String?      @db.Text
  version       Int          @default(1)
  fields        Json
  bodyTemplate  String       @db.LongText
  isActive      Boolean      @default(true)
  createdById   String       @db.VarChar(30)
  createdAt     DateTime     @default(now()) @db.DateTime(3)
  updatedAt     DateTime     @updatedAt @db.DateTime(3)

  createdBy User       @relation("TemplateCreator", fields: [createdById], references: [id], onDelete: Restrict)
  documents Document[]

  @@unique([type, version])
  @@index([type, isActive])
  @@map("document_templates")
}

model Document {
  id               String         @id @default(cuid()) @db.VarChar(30)
  type             DocumentType
  status           DocumentStatus @default(DRAFT)
  title            String         @db.VarChar(200)
  reference        String         @unique @db.VarChar(60)
  templateId       String?        @db.VarChar(30)
  createdById      String         @db.VarChar(30)
  templateVersion  Int?
  formData         Json
  pdfOriginalKey   String?        @db.VarChar(500)
  pdfFinalKey      String?        @db.VarChar(500)
  contentHash      String?        @db.VarChar(128)
  sentAt           DateTime?      @db.DateTime(3)
  completedAt      DateTime?      @db.DateTime(3)
  expiresAt        DateTime?      @db.DateTime(3)
  createdAt        DateTime       @default(now()) @db.DateTime(3)
  updatedAt        DateTime       @updatedAt @db.DateTime(3)

  template        DocumentTemplate? @relation(fields: [templateId], references: [id], onDelete: Restrict)
  createdBy       User              @relation("DocumentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  signers         DocumentSigner[]
  signatureEvents SignatureEvent[]
  receipts        Receipt[]
  recipients      DocumentRecipient[]

  @@index([type, status])
  @@index([createdById, createdAt])
  @@index([status, expiresAt])
  @@map("documents")
}

model DocumentSigner {
  id                  String       @id @default(cuid()) @db.VarChar(30)
  documentId          String       @db.VarChar(30)
  userId              String?      @db.VarChar(30)
  email               String       @db.VarChar(254)
  fullName            String       @db.VarChar(160)
  role                SignerRole
  status              SignerStatus @default(PENDING)
  signingOrder        Int          @default(1)
  invitationTokenHash String?      @unique @db.VarChar(255)
  invitedAt           DateTime?    @db.DateTime(3)
  signedAt            DateTime?    @db.DateTime(3)
  refusedAt           DateTime?    @db.DateTime(3)
  createdAt           DateTime     @default(now()) @db.DateTime(3)
  updatedAt           DateTime     @updatedAt @db.DateTime(3)

  document      Document            @relation(fields: [documentId], references: [id], onDelete: Restrict)
  user          User?               @relation("SignerUser", fields: [userId], references: [id], onDelete: SetNull)
  verifications EmailVerification[]
  events        SignatureEvent[]

  @@unique([documentId, email, role])
  @@index([email, status])
  @@index([documentId, signingOrder])
  @@map("document_signers")
}

model EmailVerification {
  id            String    @id @default(cuid()) @db.VarChar(30)
  signerId      String    @db.VarChar(30)
  codeHash      String    @db.VarChar(255)
  expiresAt     DateTime  @db.DateTime(3)
  attempts      Int       @default(0)
  maxAttempts   Int       @default(5)
  consumedAt    DateTime? @db.DateTime(3)
  invalidatedAt DateTime? @db.DateTime(3)
  createdAt     DateTime  @default(now()) @db.DateTime(3)

  signer DocumentSigner @relation(fields: [signerId], references: [id], onDelete: Cascade)

  @@index([signerId, expiresAt])
  @@map("email_verifications")
}

model SignatureEvent {
  id           String          @id @default(cuid()) @db.VarChar(30)
  documentId   String          @db.VarChar(30)
  signerId     String          @db.VarChar(30)
  action       SignatureAction
  occurredAt   DateTime        @default(now()) @db.DateTime(3)
  ipHash       String?         @db.VarChar(128)
  userAgent    String?         @db.VarChar(500)
  documentHash String?         @db.VarChar(128)
  evidence     Json?

  document Document       @relation(fields: [documentId], references: [id], onDelete: Restrict)
  signer   DocumentSigner @relation(fields: [signerId], references: [id], onDelete: Restrict)

  @@index([documentId, occurredAt])
  @@index([signerId, occurredAt])
  @@map("signature_events")
}

model Roster {
  id          String       @id @default(cuid()) @db.VarChar(30)
  name        String       @db.VarChar(120)
  game        String       @db.VarChar(100)
  status      RosterStatus @default(RECRUITING)
  description String?      @db.Text
  createdById String       @db.VarChar(30)
  createdAt   DateTime     @default(now()) @db.DateTime(3)
  updatedAt   DateTime     @updatedAt @db.DateTime(3)

  createdBy User           @relation("RosterCreator", fields: [createdById], references: [id], onDelete: Restrict)
  members   RosterMember[]

  @@index([game, status])
  @@map("rosters")
}

model RosterMember {
  id       String    @id @default(cuid()) @db.VarChar(30)
  rosterId String    @db.VarChar(30)
  userId   String    @db.VarChar(30)
  position String?   @db.VarChar(100)
  joinedAt DateTime  @default(now()) @db.DateTime(3)
  leftAt   DateTime? @db.DateTime(3)

  roster Roster @relation(fields: [rosterId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([rosterId, userId])
  @@index([userId, leftAt])
  @@map("roster_members")
}

model DisciplinaryAction {
  id           String         @id @default(cuid()) @db.VarChar(30)
  targetUserId String         @db.VarChar(30)
  createdById  String         @db.VarChar(30)
  type         DisciplineType
  reason       String         @db.Text
  startsAt     DateTime       @db.DateTime(3)
  endsAt       DateTime?      @db.DateTime(3)
  notifiedAt   DateTime?      @db.DateTime(3)
  documentId   String?        @db.VarChar(30)
  createdAt    DateTime       @default(now()) @db.DateTime(3)

  target    User @relation("DisciplineTarget", fields: [targetUserId], references: [id], onDelete: Restrict)
  createdBy User @relation("DisciplineCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([targetUserId, startsAt])
  @@map("disciplinary_actions")
}

model Donation {
  id            String         @id @default(cuid()) @db.VarChar(30)
  donorName     String         @db.VarChar(180)
  donorEmail    String?        @db.VarChar(254)
  amount        Decimal        @db.Decimal(12, 2)
  currency      String         @default("EUR") @db.VarChar(3)
  receivedAt    DateTime       @db.DateTime(3)
  paymentMethod String?        @db.VarChar(80)
  reference     String?        @unique @db.VarChar(100)
  status        DonationStatus @default(RECORDED)
  notes         String?        @db.Text
  recordedById  String         @db.VarChar(30)
  createdAt     DateTime       @default(now()) @db.DateTime(3)

  recordedBy  User          @relation("DonationRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  receipt     Receipt?
  ledgerEntries LedgerEntry[]

  @@index([receivedAt, status])
  @@map("donations")
}

model Receipt {
  id          String   @id @default(cuid()) @db.VarChar(30)
  number      String   @unique @db.VarChar(60)
  donationId  String   @unique @db.VarChar(30)
  documentId  String?  @db.VarChar(30)
  createdById String   @db.VarChar(30)
  issuedAt    DateTime @default(now()) @db.DateTime(3)
  pdfKey      String?  @db.VarChar(500)
  contentHash String?  @db.VarChar(128)
  isFiscal     Boolean @default(false)

  donation  Donation  @relation(fields: [donationId], references: [id], onDelete: Restrict)
  document  Document? @relation(fields: [documentId], references: [id], onDelete: Restrict)
  createdBy User      @relation("ReceiptCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@map("receipts")
}

model LedgerEntry {
  id            String             @id @default(cuid()) @db.VarChar(30)
  entryNumber   String             @unique @db.VarChar(60)
  type          FinanceEntryType
  status        FinanceEntryStatus @default(DRAFT)
  label         String             @db.VarChar(200)
  amount        Decimal            @db.Decimal(12, 2)
  currency      String             @default("EUR") @db.VarChar(3)
  occurredAt    DateTime           @db.DateTime(3)
  donationId    String?            @db.VarChar(30)
  createdById   String             @db.VarChar(30)
  attachmentKey String?            @db.VarChar(500)
  notes         String?            @db.Text
  createdAt     DateTime           @default(now()) @db.DateTime(3)
  validatedAt   DateTime?          @db.DateTime(3)

  donation  Donation? @relation(fields: [donationId], references: [id], onDelete: Restrict)
  createdBy User      @relation("LedgerCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([occurredAt, status])
  @@index([type, occurredAt])
  @@map("ledger_entries")
}

model AuditLog {
  id         String   @id @default(cuid()) @db.VarChar(30)
  actorId    String?  @db.VarChar(30)
  action     String   @db.VarChar(120)
  entityType String   @db.VarChar(100)
  entityId   String?  @db.VarChar(60)
  metadata   Json?
  createdAt  DateTime @default(now()) @db.DateTime(3)

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@map("audit_logs")
}


// Relation explicite entre un compte Parent et un compte Joueur.
model ParentPlayerLink {
  id              String   @id @default(cuid()) @db.VarChar(30)
  parentId        String   @db.VarChar(30)
  playerId        String   @db.VarChar(30)
  relationship    String   @default("representant_legal") @db.VarChar(80)
  status          String   @default("PENDING") @db.VarChar(20)
  requestedById   String   @db.VarChar(30)
  verifiedById    String?  @db.VarChar(30)
  verifiedAt      DateTime? @db.DateTime(3)
  createdAt       DateTime @default(now()) @db.DateTime(3)
  updatedAt       DateTime @updatedAt @db.DateTime(3)
  parent          User @relation("ParentLinks", fields: [parentId], references: [id], onDelete: Cascade)
  player          User @relation("PlayerLinks", fields: [playerId], references: [id], onDelete: Cascade)
  @@unique([parentId, playerId])
  @@index([playerId, status])
  @@index([parentId, status])
  @@map("parent_player_links")
}

// Affectation explicite d'un document à un compte utilisateur.
model DocumentRecipient {
  id          String   @id @default(cuid()) @db.VarChar(30)
  documentId  String   @db.VarChar(30)
  userId      String   @db.VarChar(30)
  assignedById String  @db.VarChar(30)
  createdAt   DateTime @default(now()) @db.DateTime(3)
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([documentId, userId])
  @@index([userId, createdAt])
  @@map("document_recipients")
}


// Compteur transactionnel : une séquence par type de document et par année.
model DocumentNumberCounter {
  id           String      @id @db.VarChar(80)
  year         Int
  type         DocumentType
  currentValue Int         @default(0)
  updatedAt    DateTime    @updatedAt @db.DateTime(3)

  @@unique([year, type])
  @@map("document_number_counters")
}
